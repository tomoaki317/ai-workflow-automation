                      "id":  "32a7b80b-95ed-4287-9c8a-19e724e2c5cc",
                      "name":  "Message a model",
                      "credentials":  {
                                          "openAiApi":  {
                                                            "id":  "YOUR_CREDENTIAL_ID",
                                                            "name":  "OpenAI account"
                                                        }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const raw = $json.output?.[0]?.content?.[0]?.text;\n\nlet parsed;\n\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  return [\n    {\n      json: {\n        valid: false,\n        manual_review: true,\n        reason: \"invalid_json\",\n        raw_output: raw\n      }\n    }\n  ];\n}\n\nconst allowedCategories = [\n  \"system_trouble\",\n  \"account\",\n  \"contract\",\n  \"general\",\n  \"other\"\n];\n\nconst allowedPriorities = [\n  \"high\",\n  \"medium\",\n  \"low\"\n];\n\nconst valid =\n  allowedCategories.includes(parsed.category) \u0026\u0026\n  allowedPriorities.includes(parsed.priority) \u0026\u0026\n  typeof parsed.summary === \"string\" \u0026\u0026\n  parsed.summary.trim() !== \"\" \u0026\u0026\n  typeof parsed.required_action === \"string\" \u0026\u0026\n  parsed.required_action.trim() !== \"\";\n\nreturn [\n  {\n    json: {\n      inquiry_id: $(\"Webhook\").first().json.body.inquiry_id,\n      received_at: new Date().toISOString(),\n      valid,\n      manual_review: !valid,\n      reason: valid ? null : \"invalid_schema_or_value\",\n      analysis: parsed\n    }\n  }\n];"
                                     },
